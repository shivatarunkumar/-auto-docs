{
  "name": "autodocs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Source-backed documentation for codebases: HTML + draw.io diagrams, runbooks, and Confluence export. Diagram engine forked from Autodocs 3.2.",
  "license": "Apache-2.0",
  "bin": {
    "autodocs": "./bin/autodocs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "render:examples": "node scripts/render-examples.mjs ../examples"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "simple-icons": "16.28.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
